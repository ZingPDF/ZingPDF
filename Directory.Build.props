<Project>
  <PropertyGroup>
    <VersionBase>1.0.59</VersionBase>
    <Version Condition="'$(Version)' == ''">$(VersionBase)-dev</Version>
    <AssemblyVersion Condition="'$(AssemblyVersion)' == ''">$(VersionBase).0</AssemblyVersion>
    <FileVersion Condition="'$(FileVersion)' == ''">$(VersionBase).0</FileVersion>
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">$(Version)</InformationalVersion>
  </PropertyGroup>
  <PropertyGroup>
    <SixLaborsLicenseKey Condition="'$(SixLaborsLicenseKey)' == '' and '$(SIXLABORS_LICENSE_KEY)' != ''">$(SIXLABORS_LICENSE_KEY)</SixLaborsLicenseKey>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)Directory.Build.local.props" Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.local.props')" />
</Project>
