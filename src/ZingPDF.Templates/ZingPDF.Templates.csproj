<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <PackageId>ZingPDF.Templates</PackageId>
    <Authors>Thomas Bowers</Authors>
    <Company>ZingPDF</Company>
    <Description>Shared template abstractions for ZingPDF PDF template renderer packages.</Description>
    <PackageTags>pdf;templates;documents</PackageTags>
    <PackageProjectUrl>https://zingpdf.dev</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ZingPDF/ZingPDF</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.Templates.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\docs\packages\README.Templates.md" Pack="true" PackagePath="/" Link="README.Templates.md" />
    <None Include="..\..\docs\packages\logomark.svg" Pack="true" PackagePath="/" Link="logomark.svg" />
    <None Include="..\..\docs\project\SUPPORT.md" Pack="true" PackagePath="/" Link="SUPPORT.md" />
    <None Include="..\..\LICENSE.txt" Pack="true" PackagePath="/" Link="LICENSE.txt" />
  </ItemGroup>

</Project>
