<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeInternalProjectOutputs</TargetsForTfmSpecificBuildOutput>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <PackageId>ZingPDF</PackageId>
    <Authors>Thomas Bowers</Authors>
    <Company>ZingPDF</Company>
    <Description>.NET 8 PDF library for loading, creating, editing, rendering, merging, watermarking, compressing, extracting text, filling and flattening forms, and encrypting PDF documents.</Description>
    <PackageTags>pdf;dotnet-pdf;csharp;forms;acroform;text-extraction;pdf-rendering;png;encryption;compression;watermark;merge-pdf;split-pdf</PackageTags>
    <PackageProjectUrl>https://zingpdf.dev</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ZingPDF/ZingPDF</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.Package.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.4" />
    <PackageReference Include="MorseCode.ITask" Version="2.0.3" />
    <PackageReference Include="Nito.AsyncEx.Coordination" Version="5.1.2" />
    <PackageReference Include="PDFtoImage" Version="5.2.1" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.2" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZingPDF.Fonts\ZingPDF.Fonts.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
	<ProjectReference Include="..\ZingPDF.InheritableSourceGenerator\ZingPDF.InheritableSourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Spec\ISO_32000-2-2020.pdf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\docs\packages\README.Package.md" Pack="true" PackagePath="/" Link="README.Package.md" />
    <None Include="..\..\docs\packages\logomark.svg" Pack="true" PackagePath="/" Link="logomark.svg" />
    <None Include="..\..\docs\project\SUPPORT.md" Pack="true" PackagePath="/" Link="SUPPORT.md" />
    <None Include="..\..\LICENSE.txt" Pack="true" PackagePath="/" Link="LICENSE.txt" />
  </ItemGroup>

  <Target Name="IncludeInternalProjectOutputs">
    <ItemGroup>
      <BuildOutputInPackage Include="..\ZingPDF.Fonts\bin\$(Configuration)\$(TargetFramework)\ZingPDF.Fonts.dll" Condition="Exists('..\ZingPDF.Fonts\bin\$(Configuration)\$(TargetFramework)\ZingPDF.Fonts.dll')">
        <TargetPath>ZingPDF.Fonts.dll</TargetPath>
      </BuildOutputInPackage>
      <BuildOutputInPackage Include="..\ZingPDF.Fonts\bin\$(Configuration)\$(TargetFramework)\ZingPDF.Fonts.xml" Condition="Exists('..\ZingPDF.Fonts\bin\$(Configuration)\$(TargetFramework)\ZingPDF.Fonts.xml')">
        <TargetPath>ZingPDF.Fonts.xml</TargetPath>
      </BuildOutputInPackage>
    </ItemGroup>
  </Target>

</Project>
