<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <PackageId>ZingPDF.Templates.LiquidHtml</PackageId>
    <Authors>Thomas Bowers</Authors>
    <Company>ZingPDF</Company>
    <Description>Liquid HTML template rendering for ZingPDF using Fluid and ZingPDF.FromHTML.</Description>
    <PackageTags>pdf;templates;liquid;html-to-pdf;documents</PackageTags>
    <PackageProjectUrl>https://zingpdf.dev</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ZingPDF/ZingPDF</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.Templates.LiquidHtml.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Fluid.Core" Version="2.31.0" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Physical" Version="9.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZingPDF.Templates\ZingPDF.Templates.csproj" />
    <ProjectReference Include="..\ZingPDF.FromHTML\ZingPDF.FromHTML.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\docs\packages\README.Templates.LiquidHtml.md" Pack="true" PackagePath="/" Link="README.Templates.LiquidHtml.md" />
    <None Include="..\..\docs\packages\logomark.svg" Pack="true" PackagePath="/" Link="logomark.svg" />
    <None Include="..\..\docs\project\SUPPORT.md" Pack="true" PackagePath="/" Link="SUPPORT.md" />
    <None Include="..\..\LICENSE.txt" Pack="true" PackagePath="/" Link="LICENSE.txt" />
  </ItemGroup>

</Project>
