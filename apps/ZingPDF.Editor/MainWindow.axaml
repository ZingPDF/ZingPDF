<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:ZingPDF.Editor"
        x:Class="ZingPDF.Editor.MainWindow" Title="{Binding Title}" Width="1180" Height="850" MinWidth="900" MinHeight="650" Background="#E9EDF2" FontFamily="Segoe UI, Inter, sans-serif" FontSize="14">
  <Window.Resources>
    <DataTemplate x:Key="RecentFileTemplate"><Button Classes="recent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Tag="{Binding Path}" Click="RecentFileClicked" ToolTip.Tip="{Binding Path}"><StackPanel Spacing="3"><TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Folder}" Classes="hint" TextTrimming="CharacterEllipsis" /></StackPanel></Button></DataTemplate>
  </Window.Resources>
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" IsHitTestVisible="{Binding !IsBusy}">
    <Border Background="White" BorderBrush="#DCE2E9" BorderThickness="0,0,0,1" Padding="20,14">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><PathIcon Data="{StaticResource BrandMark}" Width="26" Height="36" Foreground="#111827" AutomationProperties.Name="ZingPDF logo" /><TextBlock Text="ZingPDF" FontWeight="SemiBold" FontSize="20" VerticalAlignment="Center" /><TextBlock Text="Editor" Foreground="#627080" VerticalAlignment="Center" /></StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding FileName}" Foreground="#627080" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <Button Name="OpenButton" Content="Open PDF" Click="OpenClicked" />
          <Button Name="RecentFilesButton" Content="Recent ▾" ToolTip.Tip="Recently opened and saved PDFs"><Button.Flyout><Flyout><StackPanel Width="320" Spacing="10"><TextBlock Text="Recent files" Classes="panelTitle" /><TextBlock Text="No recent files yet." Classes="hint" IsVisible="{Binding !HasRecentFiles}" /><ScrollViewer MaxHeight="360"><ItemsControl ItemsSource="{Binding RecentFiles}" ItemTemplate="{StaticResource RecentFileTemplate}" /></ScrollViewer><Button Name="ClearRecentButton" Content="Clear recent files" Click="ClearRecentClicked" IsEnabled="{Binding HasRecentFiles}" /><TextBlock Text="Stored only on this computer. Clearing this list does not delete files." Classes="hint" TextWrapping="Wrap" /></StackPanel></Flyout></Button.Flyout></Button>
          <Button Content="Undo" Click="UndoClicked" IsEnabled="{Binding CanUndo}" ToolTip.Tip="Undo (Ctrl+Z)" /><Button Content="Redo" Click="RedoClicked" IsEnabled="{Binding CanRedo}" ToolTip.Tip="Redo (Ctrl+Y)" /><Button Name="SaveButton" Content="Save a copy" Classes="primary" Click="SaveClicked" IsEnabled="{Binding HasDocument}" />
        </StackPanel>
      </Grid>
    </Border>
    <Border Grid.Row="1" Background="White" Padding="20,8" IsVisible="{Binding HasDocument}"><StackPanel Orientation="Horizontal" Spacing="8">
      <Button Name="TextModeButton" Classes="task" Classes.active="{Binding IsTextMode}" Tag="Text" Click="ModeClicked"><StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Classes="line" Data="{StaticResource IconText}" /><TextBlock Text="Text" VerticalAlignment="Center" /></StackPanel></Button>
      <Button Name="PagesModeButton" Classes="task" Classes.active="{Binding IsPagesMode}" Tag="Pages" Click="ModeClicked"><StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Classes="line" Data="{StaticResource IconPages}" /><TextBlock Text="Pages" VerticalAlignment="Center" /></StackPanel></Button>
      <Button Name="FormsModeButton" Classes="task" Classes.active="{Binding IsFormsMode}" Tag="Forms" Click="ModeClicked"><StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Classes="line" Data="{StaticResource IconForm}" /><TextBlock Text="Forms" VerticalAlignment="Center" /></StackPanel></Button>
    </StackPanel></Border>
    <Border Grid.Row="2" Background="White" BorderBrush="#DCE2E9" BorderThickness="0,0,0,1" Padding="20,12" IsVisible="{Binding HasDocument}"><Grid>
      <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsTextMode}">
        <Border Background="White" BorderBrush="#D5DDE7" BorderThickness="1" CornerRadius="7" Padding="3"><StackPanel Orientation="Horizontal" Spacing="2">
          <RadioButton Name="SelectToolButton" Classes="tool" GroupName="TextTools" IsChecked="{Binding IsSelectTool, Mode=OneWay}" Click="SelectClicked" ToolTip.Tip="Select and move added text (V)"><StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Classes="line" Data="{StaticResource IconPointer}" /><TextBlock Text="Select" /></StackPanel></RadioButton>
          <RadioButton Name="AddTextButton" Classes="tool" GroupName="TextTools" IsChecked="{Binding AddingText, Mode=OneWay}" Click="AddTextClicked" ToolTip.Tip="Place new text (T); Escape to cancel"><StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Classes="line" Data="{StaticResource IconText}" /><TextBlock Text="Add text" /></StackPanel></RadioButton>
        </StackPanel></Border><TextBlock Text="Edit existing lines or add new text." Classes="hint" VerticalAlignment="Center" Margin="12,0,0,0" />
      </StackPanel>
      <WrapPanel Orientation="Horizontal" IsVisible="{Binding IsPagesMode}">
        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,14,0"><TextBlock Text="Reorder" Classes="hint" VerticalAlignment="Center" Margin="0,0,4,0" /><Button Content="←" AutomationProperties.Name="Move page earlier" ToolTip.Tip="Move selected page earlier" Click="MoveEarlierClicked" IsEnabled="{Binding CanMoveEarlier}" /><Button Content="→" AutomationProperties.Name="Move page later" ToolTip.Tip="Move selected page later" Click="MoveLaterClicked" IsEnabled="{Binding CanMoveLater}" /><Button Content="Move to…" Click="MoveToClicked" ToolTip.Tip="Move selected page to any page number" /></StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,14,0"><Button Click="RotateClicked" ToolTip.Tip="Rotate selected page clockwise"><StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Classes="line" Data="{StaticResource IconRotate}" /><TextBlock Text="Rotate" /></StackPanel></Button><Button Click="DeletePageClicked" IsEnabled="{Binding CanDeletePage}"><StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Classes="line" Data="{StaticResource IconDelete}" /><TextBlock Text="Delete" /></StackPanel></Button></StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6"><Button Click="ExtractClicked" ToolTip.Tip="Save selected page as a new PDF"><StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Classes="line" Data="{StaticResource IconExport}" /><TextBlock Text="Export page" /></StackPanel></Button><Button Click="AppendClicked" ToolTip.Tip="Append pages from another PDF"><StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Classes="line" Data="{StaticResource IconAdd}" /><TextBlock Text="Add PDF" /></StackPanel></Button></StackPanel>
      </WrapPanel>
      <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding IsFormsMode}"><TextBlock Text="Fill existing text fields. Other field types are not editable yet." Classes="hint" VerticalAlignment="Center" /><Button Content="No fillable field? Add text" Click="AddTextClicked" /></StackPanel>
    </Grid></Border>
    <Border Grid.Row="3" Background="#FFF0ED" BorderBrush="#F1BFB6" BorderThickness="0,0,0,1" Padding="20,12" IsVisible="{Binding HasError}"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><TextBlock Text="{Binding Error}" Foreground="#8A2E1C" TextWrapping="Wrap" VerticalAlignment="Center" /><Button Grid.Column="1" Content="Dismiss" Click="DismissClicked" /></Grid></Border>
    <Grid Grid.Row="4">
      <ScrollViewer IsVisible="{Binding !HasDocument}"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18" Margin="24,40" Width="520">
        <TextBlock Text="Make your PDF ready to share." FontSize="30" FontWeight="Medium" HorizontalAlignment="Center" /><TextBlock Text="Add text, work with pages, and fill text fields." Foreground="#627080" HorizontalAlignment="Center" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10"><Button Content="Open a PDF" Classes="primary" Click="OpenClicked" /><Button Content="Try a sample PDF" Click="OpenSampleClicked" /></StackPanel>
        <TextBlock Text="Your files stay on this computer. Save a copy keeps the original." Classes="hint" HorizontalAlignment="Center" Margin="0,4,0,8" />
        <StackPanel Spacing="10" IsVisible="{Binding HasRecentFiles}"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Recent files" Classes="panelTitle" VerticalAlignment="Center" /><Button Grid.Column="1" Content="Clear list" Click="ClearRecentClicked" /></Grid><ItemsControl ItemsSource="{Binding RecentFiles}" ItemTemplate="{StaticResource RecentFileTemplate}" /></StackPanel>
      </StackPanel></ScrollViewer>
      <Grid Name="DocumentWorkspace" ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding HasDocument}" IsHitTestVisible="{Binding IsReady}">
        <Border Width="136" Background="#F8FAFC" BorderBrush="#DCE2E9" BorderThickness="0,0,1,0" IsVisible="{Binding !IsPagesMode}"><Grid RowDefinitions="Auto,*"><TextBlock Text="Pages" Classes="hint" Margin="16,16,0,10" /><ListBox Name="PageList" Classes="pages" Grid.Row="1" ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}" SelectionChanged="PageSelectionChanged" Background="Transparent" BorderThickness="0"><ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,8" Spacing="7"><Border Background="White" BorderBrush="#CDD7E3" BorderThickness="1" Width="84" Height="111"><Grid><TextBlock Text="{Binding Label}" Classes="hint" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding NeedsPreview}" /><Image Source="{Binding Thumbnail}" Stretch="Uniform" /></Grid></Border><TextBlock Text="{Binding Label}" FontSize="12" HorizontalAlignment="Center" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
        <Grid Grid.Column="1" RowDefinitions="Auto,*"><TextBlock Text="{Binding Hint}" Classes="hint" Margin="20,16,20,12" TextWrapping="Wrap" HorizontalAlignment="Center" />
          <ScrollViewer Name="DocumentViewer" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" IsVisible="{Binding !IsPagesMode}"><Border Margin="24,8,24,30" HorizontalAlignment="Center" VerticalAlignment="Top" BoxShadow="0 4 18 0 #240F172A"><local:PageSurface Name="DocumentSurface" /></Border></ScrollViewer>
          <Grid Grid.Row="1" RowDefinitions="Auto,*" IsVisible="{Binding IsPagesMode}"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12" Margin="0,0,0,8" IsVisible="{Binding HasOverviewBatches}"><Button Content="Previous" Click="PreviousOverviewClicked" IsEnabled="{Binding HasPreviousOverview}" /><TextBlock Text="{Binding OverviewLabel}" VerticalAlignment="Center" /><Button Content="Next" Click="NextOverviewClicked" IsEnabled="{Binding HasNextOverview}" /></StackPanel>
            <local:PageReorderListBox Grid.Row="1" Name="PageOverview" Classes="pages overview" ItemsSource="{Binding OverviewPages}" SelectedItem="{Binding SelectedPage, Mode=OneWay}" SelectionChanged="PageSelectionChanged" Background="Transparent" BorderThickness="0" Margin="18,0,18,18" IsVisible="{Binding IsPagesMode}"><ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="14" Spacing="12"><Border Background="White" BorderBrush="#CDD7E3" BorderThickness="1" Width="140" Height="186"><Grid><TextBlock Text="{Binding Label}" Classes="hint" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding NeedsPreview}" /><Image Source="{Binding Thumbnail}" Stretch="Uniform" /></Grid></Border><TextBlock Text="{Binding Label}" HorizontalAlignment="Center" /></StackPanel></DataTemplate></ListBox.ItemTemplate></local:PageReorderListBox>
          </Grid>
        </Grid>
        <Border Grid.Column="2" Width="254" Padding="20" Background="#FAFBFD" BorderBrush="#DCE2E9" BorderThickness="1,0,0,0" IsVisible="{Binding IsTextMode}"><Grid>
          <StackPanel Spacing="12" IsVisible="{Binding !HasInspectorSelection}"><TextBlock Text="Text properties" Classes="panelTitle" /><TextBlock Text="Add a note, a date, or a missing detail." TextWrapping="Wrap" Classes="hint" /><Border Background="#EEF2F8" CornerRadius="8" Padding="16" Margin="0,8,0,0"><TextBlock Text="Use Select to click an existing line. Choose Add text to place something new. Font changes are embedded automatically." TextWrapping="Wrap" Foreground="#526176" LineHeight="22" /></Border></StackPanel>
          <ScrollViewer IsVisible="{Binding HasSelection}"><StackPanel Spacing="12"><TextBlock Text="Text properties" Classes="panelTitle" /><TextBlock Text="Text" Classes="hint" /><TextBox Name="TextEditor" Text="{Binding DraftText, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" MaxLength="10000" PlaceholderText="Type your text" /><TextBlock Text="Size" Classes="hint" /><ComboBox Name="FontSizePicker" ItemsSource="{Binding FontSizes}" SelectedItem="{Binding DraftSize, Mode=TwoWay}" HorizontalAlignment="Stretch" /><TextBlock Text="Helvetica · black" Classes="hint" /><Button Name="ApplyTextButton" Content="Apply changes" Click="ApplyClicked" Classes="primary" HorizontalAlignment="Stretch" /><Button Content="Remove text" Click="RemoveTextClicked" HorizontalAlignment="Stretch" /><TextBlock Text="Drag the text outline to move it. Arrow keys move it a little; Shift moves it further." Classes="hint" TextWrapping="Wrap" Margin="0,8,0,0" /></StackPanel></ScrollViewer>
          <Grid IsVisible="{Binding HasExistingSelection}" RowDefinitions="*,Auto" RowSpacing="12"><ScrollViewer><StackPanel Spacing="12">
            <TextBlock Text="Edit existing line" Classes="panelTitle" />
            <TextBox Name="ExistingTextEditor" Text="{Binding ExistingDraftText, Mode=TwoWay}" IsReadOnly="{Binding !CanEditExisting}" TextWrapping="Wrap" MinHeight="90" MaxLength="10000" />
            <TextBlock Text="Font" Classes="hint" /><TextBlock Text="{Binding ExistingFontDescription}" TextWrapping="Wrap" FontSize="13" />
            <Button Name="ChooseExistingFontButton" Content="Choose font…" Click="ChooseExistingFontClicked" IsEnabled="{Binding CanEditExisting}" HorizontalAlignment="Stretch" />
            <Button Content="Use original font" Click="OriginalFontClicked" IsVisible="{Binding HasChosenExistingFont}" HorizontalAlignment="Stretch" />
            <TextBlock Text="Size" Classes="hint" /><NumericUpDown Name="ExistingFontSizeEditor" Value="{Binding ExistingDraftSize, Mode=TwoWay}" Minimum="1" Maximum="1000" Increment="1" FormatString="0.##" IsEnabled="{Binding CanEditExisting}" />
            <Border Background="#FFF5DF" CornerRadius="6" Padding="12" IsVisible="{Binding HasExistingEditMessage}"><TextBlock Text="{Binding ExistingEditMessage}" TextWrapping="Wrap" Foreground="#765116" FontSize="13" /></Border>
            <CheckBox Name="AllowExistingOverflowCheck" Content="Allow text to extend" IsChecked="{Binding AllowExistingOverflow, Mode=TwoWay}" IsVisible="{Binding ExistingWouldOverflow}" ToolTip.Tip="Let the replacement extend beyond its available line space." />
            <TextBlock Text="Checking characters and line width…" Classes="hint" IsVisible="{Binding IsCheckingExistingEdit}" TextWrapping="Wrap" />
            <TextBlock Text="The line keeps its original position and colour. Longer text does not reflow other lines." Classes="hint" TextWrapping="Wrap" />
          </StackPanel></ScrollViewer><StackPanel Grid.Row="1" Spacing="8">
            <Button Name="ApplyExistingTextButton" Content="Apply changes" Click="ApplyClicked" Classes="primary" IsEnabled="{Binding CanApplyExisting}" HorizontalAlignment="Stretch" />
            <Button Name="DiscardExistingTextButton" Content="Discard changes" Click="DiscardExistingTextClicked" IsVisible="{Binding HasExistingDraft}" HorizontalAlignment="Stretch" />
          </StackPanel></Grid>
        </Grid></Border>
        <Border Grid.Column="2" Width="254" Padding="20" Background="#FAFBFD" BorderBrush="#DCE2E9" BorderThickness="1,0,0,0" IsVisible="{Binding IsFormsMode}"><ScrollViewer><StackPanel Spacing="12"><TextBlock Text="Form fields" Classes="panelTitle" /><TextBlock Text="No supported text fields were found. Use Add text to write on the page." Classes="hint" TextWrapping="Wrap" IsVisible="{Binding NoFields}" /><ComboBox Name="FormFieldPicker" ItemsSource="{Binding FormFields}" SelectedItem="{Binding SelectedField, Mode=TwoWay}" SelectionChanged="FormSelectionChanged" HorizontalAlignment="Stretch" PlaceholderText="Choose a field"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBox Text="{Binding FormDraft, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" IsVisible="{Binding HasField}" IsEnabled="{Binding CanEditField}" /><Button Content="Apply field value" Click="ApplyClicked" Classes="primary" IsEnabled="{Binding CanEditField}" HorizontalAlignment="Stretch" /><TextBlock Text="Read-only and password fields cannot be changed. Values are saved in the PDF's existing form." Classes="hint" TextWrapping="Wrap" /></StackPanel></ScrollViewer></Border>
      </Grid>
    </Grid>
    <Border Grid.Row="5" Padding="20,10" Background="White" BorderBrush="#DCE2E9" BorderThickness="0,1,0,0"><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding PageLabel}" Classes="hint" VerticalAlignment="Center" /><Button Name="JumpPageButton" Content="Go to…" Click="JumpPageClicked" IsVisible="{Binding HasDocument}" ToolTip.Tip="Jump to a page number" /></StackPanel><Grid Grid.Column="1" ColumnDefinitions="36,*" ColumnSpacing="12" VerticalAlignment="Center"><Border Width="36" ClipToBounds="True" VerticalAlignment="Center"><ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Width="36" MinWidth="0" Height="3" /></Border><TextBlock Grid.Column="1" Text="{Binding Status}" Classes="hint" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" /></Grid><Border Grid.Column="2" IsVisible="{Binding HasDocument}"><ComboBox Name="ZoomPicker" AutomationProperties.Name="Page zoom" ItemsSource="{Binding ZoomChoices}" SelectedItem="{Binding ZoomChoice, Mode=TwoWay}" IsVisible="{Binding !IsPagesMode}" IsEnabled="{Binding HasDocument}" Width="126" /></Border></Grid></Border>
  </Grid>
</Window>
