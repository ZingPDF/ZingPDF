{
  "metadata": [
    {
      "src": [
        {
          "src": "../..",
          "files": [
            "src/ZingPDF/ZingPDF.csproj",
            "src/ZingPDF.FromHTML/ZingPDF.FromHTML.csproj",
            "src/ZingPDF.Templates/ZingPDF.Templates.csproj",
            "src/ZingPDF.Templates.LiquidHtml/ZingPDF.Templates.LiquidHtml.csproj",
            "src/ZingPDF.OCR/ZingPDF.OCR.csproj"
          ]
        }
      ],
      "dest": "api",
      "properties": {
        "TargetFramework": "net8.0"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "index.md",
          "toc.yml",
          "api/**.yml"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "logo.svg",
          "favicon.svg",
          "styles/**"
        ]
      }
    ],
    "output": "../api",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appTitle": "ZingPDF API Reference",
      "_appName": "ZingPDF",
      "_appFooter": "Generated from source with DocFX.",
      "_appLogoPath": "logo.svg",
      "_appFaviconPath": "favicon.svg",
      "_appCssPath": "styles/docfx-overrides.css?v=20260421-1",
      "_disableContribution": true,
      "_enableSearch": true,
      "_noindex": false
    },
    "sitemap": {
      "baseUrl": "https://zingpdf.dev/api/"
    }
  }
}
